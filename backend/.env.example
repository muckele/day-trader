# Core app
PORT=4000
JWT_SECRET=replace_with_strong_secret

# MongoDB
# In local development the backend prefers a local MongoDB instance by default.
# Default local URI if omitted: mongodb://127.0.0.1:27017/daytrader
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/daytrader
# Optional: set false if you want Atlas attempted before local during development.
MONGO_PREFER_LOCAL=true

# Atlas
# Prefer the Atlas SRV string from "Drivers > Connect your application":
# mongodb+srv://<db_user>:<db_pass>@<cluster-host>/daytrader?retryWrites=true&w=majority
MONGO_URI=

# Optional: if SRV DNS is blocked on your network, add Atlas "Standard connection string" here.
MONGO_URI_DIRECT=

# Optional: custom resolvers for SRV lookup troubleshooting.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: retry tuning for Mongo reconnect loop
MONGO_RETRY_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# Optional: network-family preference for Mongo connections (4 or 6).
# Production defaults to IPv4 when unset.
# MONGO_IP_FAMILY=4

# Alpaca
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_URL=https://data.alpaca.markets
APCA_DATA_FEED=iex
# Controlled-live activation accepts only explicit live-only credentials. Leave
# blank until a separately reviewed Sprint 4 activation deployment.
APCA_LIVE_API_KEY_ID=
APCA_LIVE_API_SECRET_KEY=
APCA_LIVE_BASE_URL=https://api.alpaca.markets
# Set true to submit app paper-trade orders to your Alpaca paper account before recording the local paper ledger.
APP_PAPER_TRADES_SYNC_TO_ALPACA=false

# Trading environment defaults
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
# Controlled-live readiness evidence thresholds. Raising these values is safe;
# reducing them should require an explicit readiness-policy review.
ROBOTRADER_READINESS_MIN_SHADOW_RUNS=20
ROBOTRADER_READINESS_MIN_SHADOW_DAYS=7
ROBOTRADER_READINESS_WINDOW_DAYS=30
SHORT_SELLING_ENABLED=false
MARGIN_TRADING_ENABLED=false
OPTIONS_TRADING_ENABLED=false
CRYPTO_TRADING_ENABLED=true
LEVERAGED_ETF_ENABLED=false
INVERSE_ETF_ENABLED=false

# Recommendation engine
RECOMMENDATION_BENCHMARK=SPY
# RECOMMENDATION_UNIVERSE=AAPL,MSFT,NVDA,SPY,QQQ,TLT
# RECOMMENDATION_MAX_IDEAS_PER_LIST=5
# RECOMMENDATION_TOP_COUNT=5

# Research intelligence
# Optional: enables AI-generated stock research summaries. Without a key, the app uses a deterministic fallback.
OPENAI_API_KEY=
# Optional aliases/tuning:
# RESEARCH_AI_API_KEY=
# RESEARCH_AI_MODEL=gpt-4o-mini
# RESEARCH_AI_ENABLED=true
